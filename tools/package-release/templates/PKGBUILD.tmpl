# Generated for a tagged release. Review before submitting to the AUR.
pkgname=awss
pkgver={{ .PackageVersion }}
pkgrel=1
pkgdesc='Interactive AWS profile and region switcher'
arch=('x86_64' 'aarch64')
url='https://github.com/juthrbog/awss'
license=('Apache-2.0')
makedepends=('go>=1.27.1')
_release_version='{{ .Version }}'
source=("awss-${_release_version}.tar.gz::${url}/releases/download/{{ .Tag }}/awss_${_release_version}_source.tar.gz")
sha256sums=('{{ index .Checksums "source" }}')

build() {
  cd "awss-${_release_version}"
  export CGO_ENABLED=0
  go build -trimpath -mod=readonly -buildmode=pie \
    -ldflags="-s -w -X github.com/juthrbog/awss/cmd.version=${_release_version}" \
    -o awss .
  ./awss completion bash > awss.bash
  ./awss completion zsh > _awss
  ./awss completion fish > awss.fish
}

check() {
  cd "awss-${_release_version}"
  go test ./...
  ./awss --version
}

package() {
  cd "awss-${_release_version}"
  install -Dm755 awss "${pkgdir}/usr/bin/awss"
  install -Dm644 awss.bash "${pkgdir}/usr/share/bash-completion/completions/awss"
  install -Dm644 _awss "${pkgdir}/usr/share/zsh/site-functions/_awss"
  install -Dm644 awss.fish "${pkgdir}/usr/share/fish/vendor_completions.d/awss.fish"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/awss/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/awss/README.md"
}
